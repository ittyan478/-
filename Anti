local RunService = game:GetService("RunService")

-- 調整値 --------------------------------------------------------------
local HOLD_SETTLE = 0.02 -- Hold送信からDrop送信までの待ち(サーバー側で保持を反映させる間)
-- 毎フレーム RunService.Heartbeat でスキャンし最速でブレイクする。
-- フォルダはキャッシュし、同じHoldは1回だけブレイクするため FPS・ping への影響を抑える
-- ----------------------------------------------------------------------

local enabled = false
local generation = 0
local folders = {}
local folderSet = {}
local workspaceConn = nil
local stealConn = nil
local seenHolds = {}

local function addFolder(folder)
    if not folderSet[folder] then
        folderSet[folder] = true
        folders[#folders + 1] = folder
    end
end

local function onWorkspaceChild(v)
    if not v:IsA("Folder") or v.Parent ~= Workspace then return end
    local name = v.Name
    local suffix = "SpawnedInToys"
    if #name <= #suffix or name:sub(#name - #suffix + 1) ~= suffix then return end
    local p = Players:FindFirstChild(name:sub(1, #name - #suffix))
    if not p or p == LocalPlayer then return end
    addFolder(v)
end

local function collectTargets()
    local t = {}
    pcall(function()
        for i = #folders, 1, -1 do
            local folder = folders[i]
            if not folder.Parent then
                table.remove(folders, i)
                folderSet[folder] = nil
                continue
            end
            for _, v in ipairs(folder:GetDescendants()) do
                if v.Name == "HoldPart" and not seenHolds[v] then
                    local hold = v:FindFirstChild("HoldItemRemoteFunction")
                    local drop = v:FindFirstChild("DropItemRemoteFunction")
                    if hold and drop then
                        t[#t + 1] = { Part = v, Hold = hold, Drop = drop }
                    end
                end
            end
        end
    end)
    for h in pairs(seenHolds) do
        if not h.Parent then
            seenHolds[h] = nil
        end
    end
    return t
end

local function breakTarget(trg)
    seenHolds[trg.Part] = true
    task.spawn(function()
        if not enabled then return end
        local ch = LocalPlayer.Character
        if not ch then return end
        pcall(function()
            trg.Hold:InvokeServer(trg.Part.Parent, ch)
        end)
        task.wait(HOLD_SETTLE)
        pcall(function()
            trg.Drop:InvokeServer(trg.Part.Parent)
        end)
    end)
end

local function StartStealAll()
    if enabled or stealConn then return end
    generation += 1
    local gen = generation
    folders = {}
    folderSet = {}
    seenHolds = {}
    enabled = true
    for _, v in ipairs(Workspace:GetChildren()) do
        onWorkspaceChild(v)
    end
    workspaceConn = Workspace.ChildAdded:Connect(onWorkspaceChild)
    stealConn = RunService.Heartbeat:Connect(function()
        if not enabled or gen ~= generation then
            return
        end
        for _, tr in ipairs(collectTargets()) do
            if not enabled or gen ~= generation then break end
            breakTarget(tr)
        end
    end)
end

local function StopSteal()
    generation += 1
    enabled = false
    if stealConn then
        stealConn:Disconnect()
        stealConn = nil
    end
    if workspaceConn then
        workspaceConn:Disconnect()
        workspaceConn = nil
    end
    folders = {}
    folderSet = {}
    seenHolds = {}
end

MainTab:CreateSection("Server Anti-input")

MainTab:CreateToggle({
